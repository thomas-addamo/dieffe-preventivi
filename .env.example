# ─────────────────────────────────────────────────────────────────────────────
# Dieffe Preventivi — variabili d'ambiente
# Copia in .env.local e compila. NON committare mai .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Database PostgreSQL (Neon)
DATABASE_URL=

# Sessioni — stringa casuale: openssl rand -hex 32
SESSION_SECRET=

# Immagini (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Email (Resend) e URL pubblico dell'app
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=http://localhost:3847

# Job pianificati (pulizia cestino) — openssl rand -hex 16
CRON_SECRET=

# Assistente AI (Groq)
GROQ_API_KEY=

# Notifiche push (Web Push / VAPID) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
